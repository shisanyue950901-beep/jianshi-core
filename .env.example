# Do not commit real secrets.
JIANSHI_ENV=staging
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
R2_ACCOUNT_ID=REPLACE_ME
R2_BUCKET=jianshi-backups
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME

# R8 account UI remains disabled until Supabase Auth custom SMTP is configured.
JIANSHI_AUTH_ENABLED=0
JIANSHI_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
JIANSHI_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY
